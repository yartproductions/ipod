rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function profile(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function handle(username) { return /databases/$(database)/documents/handles/$(username); }
    function requestDoc(from, to) { return /databases/$(database)/documents/friendRequests/$(from + "_" + to); }
    function isHandle(value) { return value is string && value.matches('^[a-z][a-z0-9_]{2,19}$'); }
    function validProfile(uid, d) {
      return d.keys().hasOnly(['uid', 'username', 'displayName', 'sharing', 'createdAt', 'updatedAt', 'photo'])
        && d.keys().hasAll(['uid', 'username', 'displayName', 'sharing', 'createdAt', 'updatedAt'])
        && d.uid == uid && isHandle(d.username)
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 32
        && d.sharing is bool
        && (!('photo' in d) || validPhoto(d.photo));
    }
    // Profile picture: a small JPEG data URL (the app shrinks it to 128px first).
    function validPhoto(p) {
      return p is string && p.size() <= 40000
        && p.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
    }
    function handleAfter(uid, username) {
      return existsAfter(handle(username)) && getAfter(handle(username)).data.uid == uid;
    }
    function accepted(from, to) {
      return exists(requestDoc(from, to))
        && get(requestDoc(from, to)).data.status == 'accepted';
    }
    function friend(owner) {
      return signedIn() && (accepted(request.auth.uid, owner) || accepted(owner, request.auth.uid));
    }
    function validSong(song) {
      return song is map
        && song.keys().hasOnly(['title', 'artist', 'album', 'artworkUrl', 'listenedAt'])
        && song.keys().hasAll(['title', 'artist', 'album', 'artworkUrl', 'listenedAt'])
        && song.title is string && song.title.size() > 0 && song.title.size() <= 140
        && song.artist is string && song.artist.size() <= 140
        && song.album is string && song.album.size() <= 140
        && song.artworkUrl is string && song.artworkUrl.size() <= 500
        && song.listenedAt is timestamp;
    }
    function validActivity(d, owner) {
      return d.keys().hasOnly(['uid', 'recent', 'updatedAt'])
        && d.keys().hasAll(['uid', 'recent', 'updatedAt'])
        && d.uid == owner && d.recent is list && d.recent.size() <= 3
        && (d.recent.size() < 1 || validSong(d.recent[0]))
        && (d.recent.size() < 2 || validSong(d.recent[1]))
        && (d.recent.size() < 3 || validSong(d.recent[2]));
    }
    match /handles/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && isHandle(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(profile(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && existsAfter(profile(request.auth.uid))
        && getAfter(profile(request.auth.uid)).data.username != username;
    }
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if me(uid) && validProfile(uid, request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && handleAfter(uid, request.resource.data.username);
      allow update: if me(uid) && validProfile(uid, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['username', 'displayName', 'sharing', 'updatedAt', 'photo'])
        && handleAfter(uid, request.resource.data.username)
        && (request.resource.data.username == resource.data.username
          || !existsAfter(handle(resource.data.username)));
      allow delete: if false;
    }
    match /friendRequests/{id} {
      // A missing request between you and someone else reads as "doesn't exist" instead of failing,
      // so a friend card can check both directions (only ids that include your own uid).
      allow get: if signedIn() && (
        (resource == null && (id.matches(request.auth.uid + '_.+') || id.matches('.+_' + request.auth.uid)))
        || (resource != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid)));
      allow list: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['from', 'to', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + "_" + request.resource.data.to
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(profile(request.resource.data.to))
        && !exists(requestDoc(request.resource.data.to, request.auth.uid));
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.status == 'pending' && resource.data.to == request.auth.uid
           && request.resource.data.status in ['accepted', 'declined'])
          || (resource.data.status == 'accepted'
           && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid)
           && request.resource.data.status == 'declined')
          || (resource.data.status == 'declined'
           && resource.data.from == request.auth.uid
           && request.resource.data.status == 'pending')
        );
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    match /activity/{uid} {
      allow get: if me(uid) || (
        friend(uid)
        && get(profile(uid)).data.sharing == true
      );
      allow list: if false;
      allow create, update: if me(uid)
        && validActivity(request.resource.data, uid)
        && request.resource.data.updatedAt == request.time;
      allow delete: if me(uid);
    }
    // Mac Display: the Mac creates a short-lived pairing code, the phone claims it and then streams
    // what's playing (phone → Mac only). Codes can't be listed, and expire 10 minutes after creation.
    function pairDoc(code) { return /databases/$(database)/documents/pairs/$(code); }
    function inPair(code) {
      return signedIn() && (get(pairDoc(code)).data.mac == request.auth.uid
        || get(pairDoc(code)).data.get('phone', '') == request.auth.uid);
    }
    match /pairs/{code} {
      allow get: if signedIn() && (resource.data.mac == request.auth.uid
        || resource.data.get('phone', '') == request.auth.uid);
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['mac', 'createdAt'])
        && request.resource.data.mac == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (
        (!('phone' in resource.data)
          && request.time < resource.data.createdAt + duration.value(10, 'm')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'pairedAt'])
          && request.resource.data.phone == request.auth.uid
          && request.resource.data.phone != resource.data.mac
          && request.resource.data.pairedAt == request.time)
        || (resource.data.get('phone', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt'])
          && request.resource.data.state is map
          && request.resource.data.updatedAt == request.time)
      );
      allow delete: if signedIn() && (resource.data.mac == request.auth.uid
        || resource.data.get('phone', '') == request.auth.uid);
      match /art/{key} {
        allow read: if inPair(code);
        allow create, update: if signedIn() && get(pairDoc(code)).data.get('phone', '') == request.auth.uid
          && key.size() <= 16
          && request.resource.data.keys().hasOnly(['data', 'url'])
          && (!('data' in request.resource.data) || (request.resource.data.data is string
              && request.resource.data.data.size() <= 60000
              && request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
          && (!('url' in request.resource.data) || (request.resource.data.url is string
              && request.resource.data.url.size() <= 500 && request.resource.data.url.matches('^https://.*')));
        allow delete: if inPair(code);
      }
      match /lyrics/{key} {
        allow read: if inPair(code);
        allow create, update: if signedIn() && get(pairDoc(code)).data.get('phone', '') == request.auth.uid
          && key.size() <= 16
          && request.resource.data.keys().hasOnly(['lines', 'text', 'source'])
          && request.resource.data.lines is list && request.resource.data.lines.size() <= 400
          && request.resource.data.text is string && request.resource.data.text.size() <= 12000
          && request.resource.data.source is string && request.resource.data.source.size() <= 20;
        allow delete: if inPair(code);
      }
    }
    // Listen Together: a host shares a 6-character code; guests who know it can read what's playing.
    function roomDoc(code) { return /databases/$(database)/documents/rooms/$(code); }
    match /rooms/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'createdAt', 'state', 'updatedAt'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 32
        && request.resource.data.state is map
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && resource.data.host == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt'])
        && request.resource.data.state is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
      match /guests/{guest} {
        allow create, update: if signedIn() && request.auth.uid == guest && exists(roomDoc(code))
          && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 32
          && request.resource.data.joinedAt == request.time;
        allow get: if signedIn() && (request.auth.uid == guest || get(roomDoc(code)).data.host == request.auth.uid);
        allow list: if signedIn() && get(roomDoc(code)).data.host == request.auth.uid;
        allow delete: if signedIn() && (request.auth.uid == guest || get(roomDoc(code)).data.host == request.auth.uid);
      }
    }
    // Shared Playlists: anyone signed in who knows the code can read it and add songs;
    // you can remove songs you added, and the owner can remove any song or delete the playlist.
    function sharedDoc(code) { return /databases/$(database)/documents/sharedPlaylists/$(code); }
    match /sharedPlaylists/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['owner', 'ownerName', 'name', 'createdAt', 'updatedAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 32
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'name'])
        && request.resource.data.updatedAt == request.time
        && (resource.data.owner == request.auth.uid || request.resource.data.name == resource.data.name);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /tracks/{track} {
        allow read: if signedIn() && exists(sharedDoc(code));
        allow create: if signedIn() && exists(sharedDoc(code))
          && request.resource.data.keys().hasOnly(['t', 'a', 'al', 'by', 'byName', 'addedAt'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.t is string && request.resource.data.t.size() >= 1 && request.resource.data.t.size() <= 140
          && request.resource.data.a is string && request.resource.data.a.size() <= 140
          && request.resource.data.al is string && request.resource.data.al.size() <= 140
          && request.resource.data.byName is string && request.resource.data.byName.size() <= 32
          && request.resource.data.addedAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.by == request.auth.uid
          || get(sharedDoc(code)).data.owner == request.auth.uid);
      }
    }
    // Feedback & Ideas: bug reports are private to their author (the developer reads them in the
    // console); ideas are visible to every listener, who can upvote each once.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'text', 'diag', 'uid', 'name', 'createdAt'])
        && request.resource.data.kind in ['bug', 'idea']
        && request.resource.data.text is string && request.resource.data.text.size() >= 4 && request.resource.data.text.size() <= 1000
        && request.resource.data.diag is string && request.resource.data.diag.size() <= 2000
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 32
        && request.resource.data.createdAt == request.time;
      allow get, list: if signedIn() && (resource.data.kind == 'idea' || resource.data.uid == request.auth.uid);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      match /votes/{voter} {
        allow read: if signedIn();
        allow create: if signedIn() && voter == request.auth.uid
          && get(/databases/$(database)/documents/feedback/$(id)).data.kind == 'idea'
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        allow delete: if signedIn() && voter == request.auth.uid;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
